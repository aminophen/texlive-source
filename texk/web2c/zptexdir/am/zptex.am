## zpTeX
##
if ZPTEX
bin_PROGRAMS += zptex
endif ZPTEX
EXTRA_PROGRAMS += zptex

zptex_CPPFLAGS = $(PTEXENC_INCLUDES) $(AM_CPPFLAGS) -I$(srcdir)/libmd5 $(ZLIB_INCLUDES)

# With --enable-ipc, zpTeX may need to link with -lsocket.
zptex_LDADD = libukanji.a $(pproglib) $(PTEXENC_LIBS) $(LDADD) $(ipc_socketlibs) libmd5.a $(ZLIB_LIBS)
zptex_DEPENDENCIES = libukanji.a $(pproglib) $(PTEXENC_DEPEND) $(default_dependencies) libmd5.a $(ZLIB_DEPEND)

# zpTeX C sources
zptex_c_h = zptexini.c zptex0.c zptexcoerce.h zptexd.h
nodist_zptex_SOURCES = $(zptex_c_h) zptex-pool.c
dist_zptex_SOURCES = zptexdir/zptexextra.c zptexdir/zptexextra.h

# We must create zptexd.h and [eu]ptexdir/[eu]ptex_version.h before building the zptex_OBJECTS.
zptex_prereq = zptexd.h etexdir/etex_version.h ptexdir/ptex_version.h \
	eptexdir/eptex_version.h uptexdir/uptex_version.h
$(zptex_OBJECTS): $(zptex_prereq)

$(zptex_c_h): zptex-web2c
	@$(web2c) zptex
zptex-web2c: zptex.p $(web2c_texmf) zptexdir/zptex.defines
	@$(web2c) zptex

zptex-pool.c: zptex.pool zptexd.h $(makecpool_stamp)
	$(makecpool) zptex >$@ || rm -f $@

# Tangling zpTeX
zptex.p zptex.pool: zptex-tangle
	$(texmf_tangle) zptex zptex
zptex-tangle: tangle$(EXEEXT) zptex.web zptex.ch tangle-sh
	$(texmf_tangle) zptex zptex

# Generate zptex.web
zptex.web: tie$(EXEEXT) $(zptex_web_srcs)
	$(tie_m) $(zptex_web_srcs)
zptex_web_srcs = \
	tex.web \
	etexdir/etex.ch \
	etexdir/tex.ch0 \
	tex.ch \
	tracingstacklevels.ch \
	partoken.ch \
	showstream.ch \
	zlib-fmt.ch \
	etexdir/tex.ech

# Generate zptex.ch
zptex.ch: tie$(EXEEXT) zptex.web $(zptex_ch_srcs)
	$(tie_c) zptex.web $(zptex_ch_srcs)
zptex_ch_srcs = \
	zptexdir/zptex-base.ch \
	$(zptex_ch_synctex) \
	eptexdir/char-warning-eptex.ch \
	tex-binpool.ch

EXTRA_DIST += $(zptex_web_srcs) $(zptex_ch_srcs) zptexdir/zptex.defines

DISTCLEANFILES += $(nodist_zptex_SOURCES) zptex.web zptex.ch zptex-web2c \
	zptex.p zptex.pool zptex-tangle

##
EXTRA_DIST += \
	zptexdir/COPYRIGHT \
	zptexdir/COPYRIGHT.jis \
	zptexdir/ChangeLog \
	zptexdir/ZPTEX.txt

# zpTeX Tests
#
zptex_tests = zptexdir/euptriptest.test zptexdir/pdfprimitive.test zptexdir/eupver.test
zptexdir/euptriptest.log: zptex$(EXEEXT) dvitype$(EXEEXT) pltotf$(EXEEXT) tftopl$(EXEEXT)
zptexdir/pdfprimitive.log: zptex$(EXEEXT)
zptexdir/eupver.log: zptex$(EXEEXT)

EXTRA_DIST += $(zptex_tests)

if ZPTEX
TESTS += $(zptex_tests)
TRIPTRAP += euptrip.diffs
TRIPTRAP_CLEAN += euptrip-clean
endif ZPTEX

## Test data and results
##
## zptexdir/euptriptest.test
EXTRA_DIST += \
	eptexdir/eptrip/eptrip.log \
	eptexdir/eptrip/eptrip.tex \
	zptexdir/euptrip/euptrip.diffs \
	zptexdir/euptrip/texmf.cnf
euptrip.diffs: zptex$(EXEEXT) dvitype$(EXEEXT) pltotf$(EXEEXT) tftopl$(EXEEXT)
	$(triptrap_diffs) $@
.PHONY: euptrip-clean
euptrip-clean:
	rm -rf euptripdir
DISTCLEANFILES += euptrip.diffs
## zptexdir/pdfprimitive.test
EXTRA_DIST += \
	zptexdir/pdfprimitive.test \
	eptexdir/tests/pdfprimitive-test.tex \
	zptexdir/tests/pdfprimitive-zptex.log
DISTCLEANFILES += pdfprimitive-zptex.*

# (end of zptex.am)
